{{ 'faq-storefront.css' | asset_url | stylesheet_tag }}
<script src="{{ 'faq-storefront.js' | asset_url }}" defer></script>

{% style %}
  .shmart-faq-floating-trigger {
    position: fixed;
    {{ block.settings.position_vertical }}: 24px;
    {{ block.settings.position_horizontal }}: 24px;
    z-index: 99999;
    background: {{ block.settings.button_color | default: '#008060' }};
    color: #ffffff;
    border: none;
    border-radius: 50px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .shmart-faq-floating-trigger:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(0,0,0,0.25);
  }

  .shmart-faq-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    z-index: 999998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .shmart-faq-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .shmart-faq-drawer {
    position: fixed;
    top: 0;
    {{ block.settings.position_horizontal }}: 0;
    width: 100%;
    max-width: 440px;
    height: 100vh;
    background: #ffffff;
    z-index: 999999;
    box-shadow: 0 0 30px rgba(0,0,0,0.25);
    transform: translateX({% if block.settings.position_horizontal == 'left' %}-100%{% else %}100%{% endif %});
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }
  .shmart-faq-drawer.is-active {
    transform: translateX(0);
  }

  .shmart-faq-drawer-header {
    padding: 20px;
    border-bottom: 1px solid #e1e3e5;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .shmart-faq-drawer-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }
  .shmart-faq-drawer-close {
    background: transparent;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #6d7175;
    padding: 4px 8px;
  }

  .shmart-faq-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }
{% endstyle %}

<!-- Floating Launcher Button -->
<button type="button" class="shmart-faq-floating-trigger" id="shmartFaqTrigger-{{ block.id }}" aria-label="Open Help Center">
  <span>💬</span>
  <span>{{ block.settings.button_text | default: "Help & FAQs" }}</span>
</button>

<!-- Drawer Overlay & Container -->
<div class="shmart-faq-drawer-overlay" id="shmartFaqOverlay-{{ block.id }}"></div>
<div class="shmart-faq-drawer" id="shmartFaqDrawer-{{ block.id }}">
  <div class="shmart-faq-drawer-header">
    <h3>{{ block.settings.drawer_title | default: "Help & FAQ Center" }}</h3>
    <button type="button" class="shmart-faq-drawer-close" id="shmartFaqClose-{{ block.id }}">&times;</button>
  </div>

  <div class="shmart-faq-drawer-body">
    <div class="shmart-faq-container" style="padding: 0;">
      <div class="shmart-faq-search-wrapper" style="margin-bottom: 16px;">
        <span class="shmart-faq-search-icon">🔍</span>
        <input
          type="text"
          class="shmart-faq-search-input"
          placeholder="Search for answers..."
          aria-label="Search FAQs"
        >
      </div>

      <div class="shmart-faq-list" id="shmart-faq-drawer-list-{{ block.id }}">
        <!-- Dynamically Loaded FAQs -->
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const trigger = document.getElementById('shmartFaqTrigger-{{ block.id }}');
    const overlay = document.getElementById('shmartFaqOverlay-{{ block.id }}');
    const drawer = document.getElementById('shmartFaqDrawer-{{ block.id }}');
    const closeBtn = document.getElementById('shmartFaqClose-{{ block.id }}');
    const listEl = document.getElementById('shmart-faq-drawer-list-{{ block.id }}');

    function openDrawer() {
      overlay.classList.add('is-active');
      drawer.classList.add('is-active');
      loadDrawerFaqs();
    }

    function closeDrawer() {
      overlay.classList.remove('is-active');
      drawer.classList.remove('is-active');
    }

    if (trigger) trigger.addEventListener('click', openDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

    async function loadDrawerFaqs() {
      if (!listEl || listEl.dataset.loaded === 'true') return;

      try {
        const res = await fetch('/apps/faq-proxy/faqs');
        if (!res.ok) return;
        const data = await res.json();
        const faqs = data.faqs || [];

        if (faqs.length === 0) {
          listEl.innerHTML = '<p style="text-align:center; color:#6d7175; padding: 20px 0;">No FAQs available.</p>';
          return;
        }

        let html = '';
        faqs.forEach(function(faq) {
          html += `
            <div class="shmart-faq-item" data-category="${faq.categoryId || 'all'}" data-tags="${faq.tags || ''}">
              <button class="shmart-faq-question-btn" type="button" aria-expanded="false">
                <span class="shmart-faq-question-title">${faq.question}</span>
                <span class="shmart-faq-icon">⌄</span>
              </button>
              <div class="shmart-faq-answer">
                <div class="shmart-faq-answer-content">${faq.answer}</div>
                <div class="shmart-faq-feedback">
                  <span>Was this helpful?</span>
                  <div class="shmart-faq-vote-btns">
                    <button type="button" class="shmart-faq-vote-btn" data-faq-id="${faq.id}" data-vote-type="HELPFUL">👍</button>
                    <button type="button" class="shmart-faq-vote-btn" data-faq-id="${faq.id}" data-vote-type="UNHELPFUL">👎</button>
                  </div>
                </div>
              </div>
            </div>
          `;
        });

        listEl.innerHTML = html;
        listEl.dataset.loaded = 'true';

        // Bind accordion click
        listEl.querySelectorAll('.shmart-faq-item').forEach(function(item) {
          const btn = item.querySelector('.shmart-faq-question-btn');
          if (btn) {
            btn.addEventListener('click', function() {
              item.classList.toggle('is-open');
            });
          }
        });
      } catch (e) {
        console.error('Drawer FAQ fetch error:', e);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Floating FAQ Help Center",
  "target": "body",
  "stylesheet": "faq-storefront.css",
  "javascript": "faq-storefront.js",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Floating Button Label",
      "default": "Help & FAQs"
    },
    {
      "type": "text",
      "id": "drawer_title",
      "label": "Drawer Header Title",
      "default": "Help & FAQ Center"
    },
    {
      "type": "select",
      "id": "position_horizontal",
      "label": "Horizontal Position",
      "options": [
        { "value": "right", "label": "Bottom Right" },
        { "value": "left", "label": "Bottom Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "position_vertical",
      "label": "Vertical Position",
      "options": [
        { "value": "bottom", "label": "Bottom" },
        { "value": "top", "label": "Top" }
      ],
      "default": "bottom"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color",
      "default": "#008060"
    }
  ]
}
{% endschema %}
